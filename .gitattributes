# Text is stored and checked out with LF on every platform. The layout records hashes of files
# (build.py, parameters.json, part.step), so a checkout must not change a byte.
* text=auto eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
# Preserve bytes and require deliberate geometry conflict resolution.
*.step -text -diff -merge
*.stp -text -diff -merge
*.STEP -text -diff -merge
*.STP -text -diff -merge
*.FCStd -text -diff -merge
*.fcstd -text -diff -merge

# The exporter's records are kept byte for byte (CRLF and BOM included); their receipt covers them.
/references/receipts/** -text whitespace=cr-at-eol

# Generated documentation packages are tracked as binaries.
*.png -text -diff
*.pdf -text -diff
*.glb -text -diff
